# Backend Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (Supports MongoDB Atlas or Local Replica Set)
# MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.walton.mongodb.net/inventory_db?retryWrites=true&w=majority
# Local Replica Set Example:
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_db?replicaSet=rs0

# Security & CORS (Comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
